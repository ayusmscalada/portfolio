# Copy to .env.local for local development, and add the same two variables to
# your host (e.g. Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API Keys: the Project URL and the publishable
# key (sb_publishable_…) or legacy "anon" key. Both are safe in the browser;
# row-level security protects writes. NEVER use the secret (sb_secret_…) key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
