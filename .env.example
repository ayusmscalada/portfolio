# Backend settings (server only: used by server/app.js, never sent to the browser).
# Copy to .env.local for local development, and add the same variables in
# Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API Keys: the Project URL and the publishable
# key (sb_publishable_…). Row-level security protects writes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Optional, only if the backend is deployed on a different domain than the site:
# ALLOWED_ORIGINS=https://your-site.vercel.app   (set on the backend)
# API_URL=https://your-backend.vercel.app        (set on the site, needs a rebuild)
