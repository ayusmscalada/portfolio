# Backend settings (server only: used by server/app.js, never sent to the browser).
# Copy to .env.local for local development, and set the same variables in
# Vercel -> Settings -> Environment Variables.

# Added by Vercel when you connect a Blob store to the project. For local
# development copy it from Vercel -> Storage -> your store -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Password for the admin page.
ADMIN_PASSWORD=choose-a-long-password

# Optional: signs admin sessions. Derived from the values above when not set.
# SESSION_SECRET=any-long-random-string

# Optional, only if the backend is deployed on a different domain than the site:
# ALLOWED_ORIGINS=https://your-site.vercel.app   (set on the backend)
# API_URL=https://your-backend.vercel.app        (set on the site, needs a rebuild)
