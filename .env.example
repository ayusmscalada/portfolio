# Copy to .env.local for local development, and add the same two variables to
# your host (e.g. Vercel → Settings → Environment Variables).
# Supabase → Project Settings → API: the Project URL and the anon / publishable key.
# Both are safe to expose in the browser; row-level security protects writes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
